# Canonical site URL used for metadata (optional on Vercel).
NEXT_PUBLIC_SITE_URL=

# Where product enquiries are delivered. POST /api/enquiry forwards each
# validated enquiry as JSON to this URL (e.g. a Formspree, Zapier, Make,
# HubSpot or Slack-workflow webhook). Leave empty and the enquiry form falls
# back to opening the visitor's email app, addressed to contact.email in
# src/content/site.ts.
ENQUIRY_WEBHOOK_URL=
