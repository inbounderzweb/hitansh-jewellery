# Canonical site URL used for metadata (optional on Vercel).
NEXT_PUBLIC_SITE_URL=

# Optional notification hook. Enquiries are stored in MongoDB (Admin →
# Enquiries); if this is set, each one is also POSTed here as JSON (e.g. a
# Zapier/Make/Formspree webhook that emails the team). With neither a
# database nor a webhook, the form falls back to the visitor's email app,
# addressed to contact.email in src/content/site.ts.
ENQUIRY_WEBHOOK_URL=

# ----------------------------------------------------------------- Admin panel
# MongoDB connection (e.g. a MongoDB Atlas connection string). Required for
# the admin panel at /admin and to store enquiries. Without it, the public
# site serves the catalogue built into src/content/site.ts.
MONGODB_URI=
# Database name (default: hitansh).
MONGODB_DB=

# Cloudinary (Dashboard → API Keys). Server-side only: the API secret is
# never sent to the browser; uploads use short-lived server signatures.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for uploads (default: hitansh). Images go to <folder>/products and
# <folder>/collections.
CLOUDINARY_FOLDER=

# Time zone for dates in the admin panel (IANA name, default: UTC),
# e.g. Asia/Kolkata or Europe/London.
NEXT_PUBLIC_ADMIN_TIMEZONE=
